# Local development — copy to .env
PORT=4100
MCP_SERVER_URL=http://localhost:4100/mcp
ISSUER_URL=http://localhost:4100
# Backend (Mock API) OAuth callback that this server redirects to after /oauth/authorize.
# Example from MCP v1.1.md: POST /mcp_servers/{id}/oauth/start returns a redirect_uri like
# https://.../backend/webhook/mcp_servers/oauth/callback — put the local-dev value here.
MOCK_API_CALLBACK_URL=http://localhost:4000/backend/webhook/mcp_servers/oauth/callback
# Comma-separated explicit browser origins (frontend serves /mcp/callback, Inspector, Mock API UI).
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:4000,http://localhost:6274,http://localhost:4100
# Frontend OAuth callback page (served by the existing frontend, NOT this server).
FRONTEND_CALLBACK_URL=http://localhost:3000/mcp/callback
ACCESS_TOKEN_TTL=300
REFRESH_TOKEN_TTL=86400
AUTH_CODE_TTL=600
NODE_ENV=development

# Optional static bearer token (dev-only). When set, the MCP endpoint also
# accepts `Authorization: Bearer <STATIC_BEARER_TOKEN>` — use it in the Mock
# API `token` field. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Unlike OAuth tokens it never expires and cannot be refreshed.
STATIC_BEARER_TOKEN=
# Scopes granted to the static bearer token (default: all scopes).
STATIC_BEARER_SCOPES=mcp:tools test:protected

# Optional pre-provisioned OAuth client (dev-only) for the skip-DCR flow.
# When STATIC_OAUTH_CLIENT_ID is set, the Mock API can paste it (plus the
# secret, if set) into oauth_client_id/oauth_client_secret without ever
# calling POST /oauth/register. Empty secret = public client (PKCE only).
STATIC_OAUTH_CLIENT_ID=
STATIC_OAUTH_CLIENT_SECRET=
# Defaults to MOCK_API_CALLBACK_URL when unset.
STATIC_OAUTH_REDIRECT_URIS=
